# JalDrishti backend configuration
# Copy this file to .env and fill in values to go live.

PORT=4000

# ---- Sentinel Hub (optional) ----
# Leave BOTH blank to run in MOCK mode: the app generates deterministic,
# realistic NDVI/NDWI values + heatmap images so everything works offline.
# Fill both in to fetch REAL Sentinel-2 imagery via the Sentinel Hub Process API.
# Get free-trial credentials at https://apps.sentinel-hub.com/dashboard/ (OAuth client).
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Sentinel Hub endpoints (defaults are correct for the free/trial tier)
SH_TOKEN_URL=https://services.sentinel-hub.com/auth/realms/main/protocol/openid-connect/token
SH_PROCESS_URL=https://services.sentinel-hub.com/api/v1/process
